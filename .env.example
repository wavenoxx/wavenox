# WAVENOX Environment Variables Template
# Copy this file to .env and fill in the required values.
# NEVER commit your actual .env file or secret keys to version control!

# ------------------------------------------------------------------------------
# Lead Pipeline & Application Mode
# ------------------------------------------------------------------------------
# Lead capture mode:
#   - "live" (default in production): Requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
#     Fails safely with an actionable error if database credentials are missing or insertion fails.
#   - "demo": Explicit simulation mode for previews/E2E testing. Generates WNX-DEMO-* reference
#     codes and displays a visible Demo Mode notice without writing to live customer storage.
LEAD_MODE="live"
VITE_LEAD_MODE="live"

# Optional operational status override ("live" | "demo" | "preview" | "pending")
VITE_APP_STATUS="live"

# ------------------------------------------------------------------------------
# Supabase Configuration (Server-Side Only — Required when LEAD_MODE="live")
# ------------------------------------------------------------------------------
# Used exclusively by server functions (src/functions/leads.ts & src/server/supabase.ts)
# to persist consultation requests. Do not expose the service role key via VITE_* variables.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# Brand & Contact Configuration Overrides (Optional)
# ------------------------------------------------------------------------------
# Canonical site URL (used for SEO canonical links, OG tags, and sitemap)
VITE_SITE_URL="https://wavenox.in"

# Verified legal entity name (leave unset to use neutral "WAVENOX" brand identity until verified)
# VITE_COMPANY_LEGAL_NAME="WAVENOX"
# VITE_COMPANY_LEGAL_ENTITY_VERIFIED="false"

# Contact endpoints (defaults to WAVENOX concierge channels if omitted)
VITE_CONTACT_PHONE="+91 91546 26354"
VITE_CONTACT_SECONDARY_PHONE="+91 70758 70054"
VITE_CONTACT_EMAIL="wavennox@gmail.com"
VITE_HEADQUARTERS_CITY="Hyderabad"
VITE_HEADQUARTERS_STATE="Telangana"
